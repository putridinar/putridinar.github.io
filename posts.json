---
layout: none
permalink: posts.json
---
{
  "posts": [
    {% for post in site.posts %}
      {
        "title": "{{ post.title }}",
        "url": "{{ post.url }}",
        "img": "{{ post.img }}",
        "description": "{{ post.desc }}",
        "date": "{{ post.date | date: '%Y-%m-%d' }}",
        "excerpt": "{{ post.content | strip_html | strip_newlines }}"
      }
    {% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
