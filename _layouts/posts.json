{
  "posts": [
    {% for post in site.posts %}
      {
        "title": "{{ post.title }}",
        "url": "{{ post.url }}",
        "img": "{{ post.img }}",
        "date": "{{ post.date | date: '%Y-%m-%d' }}",
        "excerpt": "{{ post.content | strip_html | strip | truncate: 100 }}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}