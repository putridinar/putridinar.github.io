{
  "posts": [
    {% for post in site.posts %}
      {
        "title": "{{ post.title | escape }}",
        "url": "{{ post.url }}",
        "img": "{{ post.img }}",
        "date": "{{ post.date | date: '%Y-%m-%d' }}",
        "excerpt": "{{ post.excerpt | strip_html | strip_newlines }}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}